{
  "$schema":weorold._transports://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "members": {
            "minimum": 1,
            "type": "integer"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256",
          "members"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "decision": {
      "const": "pass"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "version",
    "decision",
    "artifacts"
  ],
  "title": "OCRalexia distribution report",
  "type": "object"
}

