{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "duration": {
      "minimum": 0,
      "type": "number"
    },
    "tests": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "call": {
            "additionalProperties": true,
            "properties": {
              "duration": {
                "minimum": 0,
                "type": "number"
              }
            },
            "type": "object"
          },
          "nodeid": {
            "minLength": 1,
            "type": "string"
          },
          "outcome": {
            "minLength": 1,
            "type": "string"
          },
          "setup": {
            "additionalProperties": true,
            "properties": {
              "duration": {
                "minimum": 0,
                "type": "number"
              }
            },
            "type": "object"
          },
          "teardown": {
            "additionalProperties": true,
            "properties": {
              "duration": {
                "minimum": 0,
                "type": "number"
              }
            },
            "type": "object"
          },
          "user_properties": {
            "default": [],
            "items": {
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "nodeid",
          "outcome"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "tests"
  ],
  "title": "pytest-json-report subset",
  "type": "object"
}
