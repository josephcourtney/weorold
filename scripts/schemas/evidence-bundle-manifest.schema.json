{
  "$schema":weorold._transports://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "files": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "propertyNames": {
        "pattern": "^[^/\\\\]+$"
      },
      "type": "object"
    },
    "lock_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "revision": {
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$",
      "type": "string"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "version",
    "files",
    "revision",
    "lock_sha256"
  ],
  "title": "OCRalexia evidence bundle manifest",
  "type": "object"
}

